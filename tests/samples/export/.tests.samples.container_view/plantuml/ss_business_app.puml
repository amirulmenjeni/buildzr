@startuml
set separator none
title app - Containers

top to bottom direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>


AddRelTag("Relationship", $textColor="#707070", $lineColor="#707070", $lineStyle = "")


Person(user, "user", $descr="", $tags="Element", $link="")

System_Boundary("app_boundary", "app", $tags="Element") {
  Container(app.web_application, "web_application", $techn="", $descr="", $tags="Element", $link="")
  Container(app.database, "database", $techn="", $descr="", $tags="Element", $link="")
}

Rel(user, app.web_application, "Uses", $techn="", $tags="Relationship", $link="")
Rel(app.web_application, app.database, "Reads from and writes to", $techn="", $tags="Relationship", $link="")

SHOW_LEGEND(true)
@enduml